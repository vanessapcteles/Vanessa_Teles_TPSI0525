{
  "imposters": [
    {
      "port": 7000,
      "protocol": "http",
      "name": "API Gestão de Funcionários",
      "stubs": [

        {
          "predicates": [
            {
              "equals": {
                "method": "POST",
                "path": "/api/funcionarios"
              }
            },
            { "matches": { "data": ".*\"salario\"\\s*:\\s*[0-9]{1,3}\\.?\\d*[^0-9]|.*\"salario\"\\s*:\\s*9[0-9]{2}\\.?\\d*" } }
          ],
          "responses": [
            {
              "is": {
                "statusCode": 400,
                "body": "Salário abaixo do mínimo exigido (1000)"
              }
            }
          ]
        },

        {
          "predicates": [
            {
              "equals": {
                "method": "GET",
                "path": "/api/funcionarios/999"
              }
            }
          ],
          "responses": [
            {
              "is": {
                "statusCode": 401,
                "body": "Acesso não autorizado. É necessário login."
              }
            }
          ]
        },

        {
          "predicates": [
            {
              "equals": {
                "method": "DELETE",
                "path": "/api/funcionarios/502"
              }
            }
          ],
          "responses": [
            {
              "is": {
                "statusCode": 409,
                "body": "Funcionário tem projetos ativos. Remoção não permitida."
              }
            }
          ]
        },

        {
          "predicates": [
            {
              "matches": {
                "method": "^(POST|PUT|DELETE)$",
                "path": "/api/funcionarios.*"
              }
            }
          ],
          "responses": [
            {
              "is": {
                "statusCode": 201,
                "headers": { "Content-Type": "application/json" },
                "body": {
                  "id": 501,
                  "status": "Operação concluída com sucesso"
                }
              }
            }
          ]
        },

        {
          "predicates": [
            {
              "matches": {
                "method": "GET",
                "path": "/api/funcionarios.*"
              }
            }
          ],
          "responses": [
            {
              "is": {
                "statusCode": 200,
                "headers": { "Content-Type": "application/json" },
                "body": [
                  {
                    "id": 501,
                    "nome": "Funcionario Teste",
                    "cargo": "Desenvolvedor",
                    "salario": 1500
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
